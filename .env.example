# Copy this file to .env and fill it in. Nothing else needs changing to go live.
# Without these values the forms stay honest: they tell visitors nothing was sent.

# 1. Create an account at https://resend.com, verify your domain, make an API key
RESEND_API_KEY=
# 2. A sender on that verified domain, e.g. Sairah Gonzalez <hello@yourdomain.com>
EMAIL_FROM=
# 3. Where the My Photo Gallery file really lives
PRODUCT_DOWNLOAD_URL=
# 4. Optional: Resend segment IDs for sorting subscribers
RESEND_NEWSLETTER_SEGMENT_ID=
RESEND_MARKETING_SEGMENT_ID=
